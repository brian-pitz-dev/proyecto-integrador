# Copiar a .env.local y completar.

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (login, signup, recuperar contraseña) — dashboard de Cloudflare
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Dominios aceptados, separados por coma. Por defecto: localhost,127.0.0.1
TURNSTILE_HOSTNAMES=

# Google Gemini (tab Coach) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo principal (por defecto gemini-3.6-flash)
GEMINI_MODEL=

# Opcional: URL pública del sitio (metadatos / Open Graph). Por defecto http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Tests e2e (npm run e2e): cuenta de prueba propia, con el registro terminado. Los tests cargan
# y borran datos con fecha de 2020 en esa cuenta. En CI van como secrets del repo.
E2E_EMAIL=
E2E_PASSWORD=

# Opcional: Strava (importar corridas en Estadísticas) — https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost para desarrollo, el dominio real en producción.
# Sin estas dos variables la tarjeta de Strava no aparece.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
